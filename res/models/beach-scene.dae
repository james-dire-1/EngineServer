  <library_effects>
    <effect id="Material_034-effect">
      <profile_COMMON>
        <newparam sid="yellow_png-surface">
          <surface type="2D">
            <init_from>yellow_png</init_from>
          </surface>
        </newparam>
        <newparam sid="yellow_png-sampler">
          <sampler2D>
            <source>yellow_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="yellow_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
